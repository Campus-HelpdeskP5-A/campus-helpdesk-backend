# ==========================================
# Campus Helpdesk Backend
# Environment Configuration
# ==========================================

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:5173

# ==========================================
# PostgreSQL / Neon
# ==========================================

DB_HOST=your-neon-host
DB_PORT=5432
DB_NAME=neondb
DB_USER=your-neon-user
DB_PASSWORD=your-neon-password

# ==========================================
# JWT
# ==========================================

JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=1d

# ==========================================
# Test / Demo Credentials
# ==========================================

TEST_USER_EMAIL=student@bua.edu.eg
TEST_USER_PASSWORD=Dev12345!

TEST_AGENT_EMAIL=agent@bua.edu.eg
TEST_AGENT_PASSWORD=Dev12345!

TEST_TECHNICIAN_EMAIL=technician@bua.edu.eg
TEST_TECHNICIAN_PASSWORD=Dev12345!

TEST_MANAGER_EMAIL=manager@bua.edu.eg
TEST_MANAGER_PASSWORD=Dev12345!

TEST_AUDITOR_EMAIL=auditor@bua.edu.eg
TEST_AUDITOR_PASSWORD=Dev12345!